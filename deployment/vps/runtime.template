# Copie este arquivo para /root/playstorcraft-runtime na VPS e execute chmod 600.
# Nunca preencha valores reais neste repositório.

# Banco MySQL
MYSQL_DATABASE=playstorcraft
MYSQL_USER=playstorcraft
MYSQL_PASSWORD=GERAR_SENHA_FORTE_ALEATORIA
MYSQL_ROOT_PASSWORD=GERAR_SENHA_ROOT_FORTE_ALEATORIA

# Aplicação e segurança
APP_BASE_URL=https://playstorcraft.com.br
JWT_SECRET=GERAR_64_OU_MAIS_CARACTERES_ALEATORIOS
MINECRAFT_API_KEY_PEPPER=GERAR_64_OU_MAIS_CARACTERES_ALEATORIOS
MAINTENANCE_SECRET=GERAR_64_OU_MAIS_CARACTERES_ALEATORIOS
DISCORD_BOT_BRIDGE_SECRET=GERAR_64_OU_MAIS_CARACTERES_ALEATORIOS

# Mercado Pago: obrigatórios antes de liberar vendas reais
MERCADO_PAGO_ACCESS_TOKEN=COLE_O_ACCESS_TOKEN_DE_PRODUCAO
MERCADO_PAGO_PUBLIC_KEY=COLE_A_PUBLIC_KEY_DE_PRODUCAO
MERCADO_PAGO_WEBHOOK_SECRET=COLE_O_SEGREDO_DO_WEBHOOK

# Bot Discord: deixar em branco somente se o bot não for ativado.
DISCORD_BOT_TOKEN=COLE_O_TOKEN_DO_BOT
DISCORD_GUILD_ID=ID_DO_SERVIDOR_DISCORD
DISCORD_ENABLE_PRESENCE=true
DISCORD_INVITE_URL=https://discord.gg/SEU_CONVITE
DISCORD_INVITE_CHANNEL_ID=ID_DO_CANAL_DE_CONVITE
DISCORD_STATUS_CHANNEL_ID=ID_DO_CANAL_DE_STATUS
DISCORD_OPERATIONS_CHANNEL_ID=ID_DO_CANAL_PRIVADO_DE_OPERACOES
DISCORD_MANAGED_INVITE=false
DISCORD_STATUS_INTERVAL_MS=90000

# Opcional: backup dos arquivos Paper no script de backup.
# PAPER_SERVER_PATH=/var/lib/pterodactyl/volumes/UUID_DO_SERVIDOR
